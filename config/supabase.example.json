{
  "schema_version": 1,
  "provider": "supabase",
  "unit": "supabase-database",
  "account_id": "REPLACE_WITH_USER_ID",
  "scope_id": "example-org",
  "resources": [{
    "key": "database",
    "type": "supabase:index/project:Project",
    "props": {
      "organizationId": "example-org",
