      "region": "eu-central-1",
      "instanceSize": "nano",
      "legacyApiKeysEnabled": false
    }
  }],
  "growth": {"egress_mb": 500, "cached_egress_mb": 500, "storage_mb": 100, "mau": 1000}
}
